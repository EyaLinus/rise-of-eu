class_name Music
extends Node
## Background music: plays the tracks in assets/music (generated by tools/gen_music.py) in random
## order with a short pause between them. Peace tracks normally, war tracks while the player is at
## war; a mood change fades the current track out and starts one of the other mood.

const TRACKS := {
	"hof_im_fruehling": "peace", "pilgerweg": "peace", "markttag": "peace", "abendlaute": "peace",
	"heerzug": "war", "belagerung": "war",
}
const FADE := 2.5  # seconds
const PAUSE_MIN := 6.0
const PAUSE_MAX := 16.0

var volume := 0.5  # 0..1, from the settings
var mood := "peace"
var current := ""
var streams := {}
var _player: AudioStreamPlayer
var _fade := 0.0  # >0: fading out, then the next track starts
var _wait := 0.0  # pause before the next track
var _rng := RandomNumberGenerator.new()


func _ready() -> void:
	_rng.randomize()
	for k in TRACKS:
		var path := "res://assets/music/%s.ogg" % k
		if ResourceLoader.exists(path):
			streams[k] = load(path)
	_player = AudioStreamPlayer.new()
	add_child(_player)
	_player.finished.connect(func(): _wait = _rng.randf_range(PAUSE_MIN, PAUSE_MAX); current = "")
	_wait = 0.5


func set_volume(v: float) -> void:
	volume = clampf(v, 0.0, 1.0)
	if volume <= 0.0:
		_player.stop()
		current = ""
	else:
		_player.volume_db = _db()
		if current == "" and _wait <= 0.0:
			_wait = 0.3


## "peace" or "war"; switching fades out a track of the other mood.
func set_mood(m: String) -> void:
	if m == mood:
		return
	mood = m
	if current != "" and TRACKS[current] != mood and _fade <= 0.0:
		_fade = FADE


func _db() -> float:
	return linear_to_db(volume * volume) - 4.0  # squared: the setting steps feel even


func _process(delta: float) -> void:
	if volume <= 0.0 or streams.is_empty():
		return
	if _fade > 0.0:
		_fade -= delta
		_player.volume_db = _db() + linear_to_db(maxf(_fade / FADE, 0.001))
		if _fade <= 0.0:
			_player.stop()
			current = ""
			_wait = 1.0
		return
	if current == "" and _wait > 0.0:
		_wait -= delta
		if _wait <= 0.0:
			_play_next()


func _play_next() -> void:
	var pool := []
	for k in streams:
		if TRACKS[k] == mood:
			pool.append(k)
	if pool.is_empty():
		pool = streams.keys()
	if pool.size() > 1:
		pool.erase(_player.get_meta("last", ""))
	current = pool[_rng.randi() % pool.size()]
	_player.set_meta("last", current)
	_player.stream = streams[current]
	_player.volume_db = _db()
	_player.play()
