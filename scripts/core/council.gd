extends RefCounted
## Council of state (data/council.json, generated by tools/content/council.py).
## Nine seats (war, diplo, trade, construction, coin, navy, army, development, education). Each seat holds at
## most one person with a skill level 1..max_skill: hired with gold from a small candidate pool, promoted with
## the seat's power (or for free after experience_years on one level), paid a monthly salary (counted in the
## government budget). Every level gives the seat's passive modifiers (n.bonus["gov"] via Government.gov_sources)
## and the seat unlocks an automation the player can switch on and limit (reserves, targets, modes) so
## repetitive tasks run by themselves. Seat names depend on the family of the form of government.
## State: n.gov.council = {seat: {name, skill, since, lvl_since, auto, opt: {key: value}}},
##        n.gov.cpool = {seat: {m: month rolled, c: [{name, skill}, ...]}}.
## The AI hires councillors for their passive effects only; automations run for the player.

const Units = preload("res://scripts/core/units.gd")
const Naval = preload("res://scripts/core/naval.gd")
const Trade = preload("res://scripts/core/trade.gd")
const Economy = preload("res://scripts/core/economy.gd")
const Tech = preload("res://scripts/core/tech.gd")

const AI_PRIORITY := ["coin", "army", "construction", "development", "war", "trade", "diplo", "education", "navy"]


static func cfg(g) -> Dictionary:
	return g.govt.council_cfg


static func seats(g) -> Array:
	return cfg(g).get("seats", [])


static func seat_def(g, id: String) -> Dictionary:
	for s in seats(g):
		if s.id == id:
			return s
	return {}


static func family(g, n) -> String:
	var f: String = g.govt.form_family(g.govt.form_name(n.tag))
	return f if f != "" else "monarchie"


static func council_name(g, n) -> String:
	return str(cfg(g).get("council_name", {}).get(family(g, n), "Rat"))


static func seat_name(g, n, id: String) -> String:
	var s := seat_def(g, id)
	return str(s.get("names", {}).get(family(g, n), id))


static func max_skill(g) -> int:
	return int(cfg(g).get("max_skill", 5))


static func member(n, id: String) -> Dictionary:
	return n.gov.get("council", {}).get(id, {})


static func skill(n, id: String) -> int:
	return int(member(n, id).get("skill", 0))


static func members(n) -> Dictionary:
	if not n.gov.has("council"):
		n.gov.council = {}
	return n.gov.council


# ---------------------------------------------------------------- costs

static func _fam_mult(g, n) -> float:
	return float(cfg(g).get("family_cost", {}).get(family(g, n), 1.0))


static func hire_cost(g, n, lvl: int) -> float:
	return round(float(cfg(g).get("hire_gold", 40)) * lvl * _fam_mult(g, n) * (1.0 + 0.004 * maxi(0, g.year() - 1444)))


## Monthly salary of the whole council (gold), part of Government.budget_cost.
static func salary(g, n) -> float:
	var s := 0
	for id in n.gov.get("council", {}):
		s += int(n.gov.council[id].get("skill", 1))
	return s * float(cfg(g).get("salary", 0.15)) * _fam_mult(g, n)


static func promote_cost(g, n, id: String) -> float:
	return round(float(cfg(g).get("promote_power", 40)) * maxi(1, skill(n, id)) * _fam_mult(g, n))


# ---------------------------------------------------------------- candidates, hire, promote, dismiss

static func _person_name(g, n) -> String:
	var base := "Rat"
	if not n.ruler_names.is_empty():
		base = n.ruler_names[g.rng.randi_range(0, n.ruler_names.size() - 1)]
	var own: Array = g.provinces_of(n.tag)
	if own.is_empty():
		return base
	return "%s aus %s" % [base, g.provinces[own[g.rng.randi_range(0, own.size() - 1)]].name]


## Candidates for `id`; rolled again after pool_months (better people show up in bigger realms and later years).
static func pool(g, n, id: String) -> Array:
	if not n.gov.has("cpool"):
		n.gov.cpool = {}
	var p: Dictionary = n.gov.cpool.get(id, {})
	if p.is_empty() or g.month - int(p.get("m", -9999)) >= int(cfg(g).get("pool_months", 12)):
		var c := []
		var top: int = clampi(2 + int(n.dev_total / 150.0) + int((g.year() - 1444) / 60), 2, max_skill(g) - 1)
		for i in int(cfg(g).get("pool_size", 3)):
			var lvl: int = 1 if i == 0 else g.rng.randi_range(1, top)
			c.append({"name": _person_name(g, n), "skill": lvl})
		c.sort_custom(func(a, b): return a.skill < b.skill)
		p = {"m": g.month, "c": c}
		n.gov.cpool[id] = p
	return p.c


static func hire_block(g, tag: String, id: String, idx: int) -> String:
	var n = g.nations[tag]
	if seat_def(g, id).is_empty():
		return "Unbekannter Sitz."
	var c: Array = pool(g, n, id)
	if idx < 0 or idx >= c.size():
		return "Kein Kandidat."
	var cost := hire_cost(g, n, int(c[idx].skill))
	if n.gold < cost:
		return "Zu wenig Gold (%d benötigt)." % int(cost)
	return ""


## Hires candidate `idx` for seat `id` (replacing a sitting member, whose automation settings are kept).
static func hire(g, tag: String, id: String, idx: int) -> String:
	var err := hire_block(g, tag, id, idx)
	if err != "":
		return err
	var n = g.nations[tag]
	var c: Dictionary = pool(g, n, id)[idx]
	n.gold -= hire_cost(g, n, int(c.skill))
	var old: Dictionary = member(n, id)
	members(n)[id] = {"name": str(c.name), "skill": int(c.skill), "since": g.month, "lvl_since": g.month,
			"auto": bool(old.get("auto", tag == g.player)), "opt": old.get("opt", default_opts(g, id))}
	n.gov.cpool[id].c.remove_at(idx)
	if n.gov.cpool[id].c.is_empty():
		n.gov.cpool.erase(id)
	g.govt.refresh(n)
	return ""


static func dismiss(g, tag: String, id: String) -> void:
	var n = g.nations[tag]
	members(n).erase(id)
	g.govt.refresh(n)


static func promote_block(g, tag: String, id: String) -> String:
	var n = g.nations[tag]
	if member(n, id).is_empty():
		return "Der Sitz ist leer."
	if skill(n, id) >= max_skill(g):
		return "Höchste Stufe erreicht."
	var kind: String = seat_def(g, id).get("power", "adm")
	var c := promote_cost(g, n, id)
	if n.get(kind) < c:
		return "Zu wenig %s (%d benötigt)." % [{"adm": "Verwaltung", "dip": "Diplomatie", "mil": "Militär"}[kind], int(c)]
	return ""


static func promote(g, tag: String, id: String) -> String:
	var err := promote_block(g, tag, id)
	if err != "":
		return err
	var n = g.nations[tag]
	var kind: String = seat_def(g, id).get("power", "adm")
	n.set(kind, n.get(kind) - promote_cost(g, n, id))
	_level_up(g, n, id)
	return ""


static func _level_up(g, n, id: String) -> void:
	var m: Dictionary = members(n)[id]
	m.skill = mini(max_skill(g), int(m.skill) + 1)
	m.lvl_since = g.month
	g.govt.refresh(n)


## Years until the member rises a level by experience alone (-1 at the top).
static func experience_left(g, n, id: String) -> int:
	var m := member(n, id)
	if m.is_empty() or int(m.skill) >= max_skill(g):
		return -1
	var need: int = int(cfg(g).get("experience_years", 6)) * 12
	return maxi(0, ceili((int(m.get("lvl_since", 0)) + need - g.month) / 12.0))


# ---------------------------------------------------------------- effects

static func seat_effects(g, id: String, lvl: int) -> Dictionary:
	var r := {}
	var per: Dictionary = seat_def(g, id).get("per_level", {})
	for k in per:
		r[k] = float(per[k]) * lvl
	return r


static func effects(g, n) -> Array:
	var r := []
	for id in n.gov.get("council", {}):
		r.append(seat_effects(g, id, skill(n, id)))
	return r


# ---------------------------------------------------------------- automation options

static func default_opts(g, id: String) -> Dictionary:
	var o := {}
	var opts: Dictionary = seat_def(g, id).get("options", {})
	for k in opts:
		o[k] = opts[k].values[int(opts[k].default)]
	return o


static func opt(g, n, id: String, key: String):
	var m := member(n, id)
	var o: Dictionary = m.get("opt", {})
	if o.has(key):
		return o[key]
	return default_opts(g, id).get(key)


static func auto_on(n, id: String) -> bool:
	var m := member(n, id)
	return not m.is_empty() and bool(m.get("auto", false))


static func set_auto(g, tag: String, id: String, on: bool) -> String:
	var n = g.nations[tag]
	if member(n, id).is_empty():
		return "Erst jemanden in den Rat berufen."
	members(n)[id].auto = on
	if id == "construction":
		n.autobuild = on
	return ""


## Cycles the option to the next allowed value (UI chip).
static func cycle_opt(g, tag: String, id: String, key: String) -> String:
	var n = g.nations[tag]
	if member(n, id).is_empty():
		return "Erst jemanden in den Rat berufen."
	var d: Dictionary = seat_def(g, id).get("options", {}).get(key, {})
	if d.is_empty():
		return "Unbekannte Einstellung."
	var vals: Array = d.values
	var i: int = vals.find(opt(g, n, id, key))
	var v = vals[(i + 1) % vals.size()]
	if not members(n)[id].has("opt"):
		members(n)[id].opt = {}
	members(n)[id].opt[key] = v
	if id == "construction" and key == "reserve":
		n.autobuild_reserve = float(v)
	return ""


static func opt_text(g, id: String, key: String, v) -> String:
	var d: Dictionary = seat_def(g, id).get("options", {}).get(key, {})
	match str(d.get("fmt", "")):
		"bool":
			return "an" if int(v) != 0 else "aus"
		"pct":
			return "%d %%" % int(v)
		"pct_cap":
			return "%d %% des Maximums" % int(v)
		"gold":
			return "%d Gold" % int(v)
		"pts":
			return "%d Punkte" % int(v)
		"mode", "focus":
			return str(cfg(g).get("mode_labels", {}).get(str(v), str(v)))
	return str(v)


# ---------------------------------------------------------------- monthly / yearly

## Yearly for every realm: experience promotes members who served experience_years on one level.
static func yearly(g, n) -> void:
	for id in n.gov.get("council", {}).keys():
		if experience_left(g, n, id) == 0:
			_level_up(g, n, id)
			if n.tag == g.player:
				g.log_msg("%s %s %s steigt durch Erfahrung auf Stufe %d." % [seat_def(g, id).icon, seat_name(g, n, id), members(n)[id].name, skill(n, id)], [n.tag])


## Player automations, once a month (after the research plan, before overflow development).
static func monthly(g, n) -> void:
	if n.gov.get("council", {}).is_empty():
		return
	if auto_on(n, "coin"):
		_auto_coin(g, n)
	if auto_on(n, "army"):
		_auto_army(g, n)
	if auto_on(n, "war"):
		_auto_war(g, n)
	if auto_on(n, "navy"):
		_auto_navy(g, n)
	if auto_on(n, "diplo"):
		_auto_diplo(g, n)
	if auto_on(n, "trade"):
		_auto_trade(g, n)
	if auto_on(n, "education"):
		_auto_education(g, n)
	if not member(n, "construction").is_empty():
		n.autobuild = auto_on(n, "construction")


## Extra autobuild projects per month from the construction seat (level 2+: one more each level).
static func extra_builds(n) -> int:
	return maxi(0, skill(n, "construction") - 1) if auto_on(n, "construction") else 0


static func _say(g, n, id: String, text: String) -> void:
	if n.tag == g.player:
		g.log_msg("🤖 %s: %s" % [seat_name(g, n, id), text], [n.tag])


static func _recruit_pid(g, n) -> int:
	var cap: int = n.capital
	if cap >= 0 and g.provinces[cap].owner == n.tag and g.provinces[cap].controller == n.tag:
		return cap
	var best := -1
	for pid in g.provinces_of(n.tag):
		if g.provinces[pid].controller == n.tag and (best < 0 or g.provinces[pid].dev > g.provinces[best].dev):
			best = pid
	return best


static func _auto_army(g, n) -> void:
	if int(opt(g, n, "army", "war_only")) != 0 and not g.is_at_war(n.tag):
		return
	var want: int = ceili(g.force_cap(n.tag) * float(opt(g, n, "army", "target")) / 100.0)
	var count: int = mini(mini(want - g.regs_counted(n.tag), g.force_room(n.tag)), mini(skill(n, "army"), int(n.manpower)))
	if count < 1:
		return
	var pid := _recruit_pid(g, n)
	if pid < 0:
		return
	var each: float = g.regiment_cost(n.tag) * Units.cost_mult(g, n.tag, Units.template_mix(g, n.tag, n.recruit_tmpl))
	var reserve := float(opt(g, n, "army", "reserve"))
	while count > 0 and n.gold - each * count < reserve:
		count -= 1
	if count > 0 and g.recruit(n.tag, pid, count) == "":
		_say(g, n, "army", "%d Regiment(er) in %s ausgehoben." % [count, g.provinces[pid].name])


static func _auto_war(g, n) -> void:
	var reserve := float(opt(g, n, "war", "reserve"))
	var min_regs := float(cfg(g).get("general_min_regs", 4))
	for a in g.armies_of(n.tag):
		if a.general <= 0 and a.regs >= min_regs and n.mil - float(g.bal.general_cost) >= reserve:
			if g.hire_general(n.tag, a.id) == "":
				_say(g, n, "war", "General für das Heer in %s ernannt." % g.provinces[a.pid].name)
				break
	var below := float(cfg(g).get("drill_below", 0.6))
	for a in g.armies_of(n.tag):
		if a.power < below * g.power_max(n.tag) and n.mil - g.drill_cost(a) >= reserve and g.provinces[a.pid].controller == n.tag \
				and not g.Warfare.in_battle(g, a):
			if g.drill_army(n.tag, a.id) == "":
				_say(g, n, "war", "Heer in %s gedrillt." % g.provinces[a.pid].name)
				break


static func _auto_navy(g, n) -> void:
	var lim: float = Naval.limit(g, n.tag)
	if lim <= 0.0:
		return
	var want: float = floorf(lim * float(opt(g, n, "navy", "target")) / 100.0)
	var count: int = mini(ceili(skill(n, "navy") / 2.0), int(want - n.ships))
	var reserve := float(opt(g, n, "navy", "reserve"))
	while count > 0 and (n.gold - Naval.ship_cost(g, n.tag) * count < reserve or Naval.build_block_reason(g, n.tag, count) != ""):
		count -= 1
	if count > 0 and Naval.build_ships(g, n.tag, count) == "":
		_say(g, n, "navy", "%d Schiff(e) gebaut." % count)


static func _auto_diplo(g, n) -> void:
	var reserve := float(opt(g, n, "diplo", "reserve"))
	if n.ae > float(opt(g, n, "diplo", "ae")) and n.ae >= 0.5 and n.dip - float(g.bal.reputation_cost) >= reserve:
		if g.restore_reputation(n.tag) == "":
			_say(g, n, "diplo", "Gesandte bessern den Ruf (AE jetzt %.1f)." % n.ae)
			return
	var worst := ""
	var low := 100.0
	for t in n.allies:
		if g.nations.has(t) and g.nations[t].alive and g.get_rel(n.tag, t) < low:
			low = g.get_rel(n.tag, t)
			worst = t
	if worst != "" and low < 95.0 and n.dip - float(g.bal.improve_relation_cost) >= reserve and g.month % 3 == 0:
		if g.improve_relations(n.tag, worst) == "":
			_say(g, n, "diplo", "Beziehung zu %s verbessert." % g.nations[worst].name)


static func _auto_trade(g, n) -> void:
	n.merchant_auto = true
	if int(opt(g, n, "trade", "ships")) == 0:
		return
	if n.gold - float(g.bal.east_ship_cost) >= float(opt(g, n, "trade", "reserve")) and Trade.ship_block_reason(g, n.tag) == "":
		if Trade.buy_ship(g, n.tag) == "":
			_say(g, n, "trade", "Ein Ostindienfahrer gekauft.")


static func _auto_coin(g, n) -> void:
	var reserve := float(opt(g, n, "coin", "reserve"))
	if int(opt(g, n, "coin", "emergency")) != 0 and n.gold + n.income - n.expenses < 0.0 and n.loans.size() < int(g.bal.max_loans):
		if Economy.take_loan(g, n.tag) == "":
			_say(g, n, "coin", "Notkredit aufgenommen, damit die Kasse nicht leer läuft.")
			return
	if int(opt(g, n, "coin", "repay")) != 0 and not n.loans.is_empty() and n.gold - float(n.loans[n.loans.size() - 1]) >= reserve:
		if Economy.repay_loan(g, n.tag) == "":
			_say(g, n, "coin", "Einen Kredit zurückgezahlt.")


static func _auto_education(g, n) -> void:
	var h: Dictionary = n.gov.get("heir", {})
	if h.is_empty():
		return
	var at: float = float(g.bal.power_cap) * float(opt(g, n, "education", "at")) / 100.0
	var focus: String = str(opt(g, n, "education", "focus"))
	var kinds: Array = [focus] if focus != "weakest" else g.POWERS.duplicate()
	if focus == "weakest":
		kinds.sort_custom(func(a, b): return int(h.get(a, 0)) < int(h.get(b, 0)))
	for k in kinds:
		if n.get(k) >= at and g.govt.educate(g, n.tag, k) == "":
			_say(g, n, "education", "%s in %s unterrichtet." % [str(h.get("name", "Der Erbe")), {"adm": "Verwaltung", "dip": "Diplomatie", "mil": "Militär"}[k]])
			return


# ---------------------------------------------------------------- development

## Overflow development for the player: with a development councillor the target and threshold follow his
## settings, without one the cheapest province is developed only at the power cap (old behaviour).
## Returns [pid, kind] pairs to develop this month.
static func dev_threshold(g, n) -> float:
	var cap := float(g.bal.power_cap)
	if member(n, "development").is_empty():
		return cap
	return cap * float(opt(g, n, "development", "at")) / 100.0


static func dev_mode(g, n) -> String:
	if member(n, "development").is_empty():
		return "cheapest"
	return str(opt(g, n, "development", "mode"))


static func dev_target(g, n) -> int:
	var mode := dev_mode(g, n)
	if mode == "off":
		return -1
	if mode == "cheapest":
		return g.cheapest_develop(n.tag)
	var maxd := int(g.bal.max_dev)
	if mode == "capital":
		var cap: int = n.capital
		if cap >= 0 and g.provinces[cap].owner == n.tag and g.provinces[cap].controller == n.tag and g.provinces[cap].dev < maxd:
			return cap
		return g.cheapest_develop(n.tag)
	var best := -1
	for pid in g.provinces_of(n.tag):
		var p = g.provinces[pid]
		if p.dev >= maxd or p.controller != n.tag:
			continue
		if best < 0 or (p.dev < g.provinces[best].dev if mode == "lowest" else p.dev > g.provinces[best].dev):
			best = pid
	return best


# ---------------------------------------------------------------- AI

## AI: fills seats for the passive effects while gold allows (more seats in larger realms).
static func ai_think(g, n) -> void:
	var want: int = mini(seats(g).size(), 1 + int(n.dev_total / 100.0 * float(cfg(g).get("ai_seats_per_100_dev", 1.5))))
	if members(n).size() >= want:
		return
	for id in AI_PRIORITY:
		if not member(n, id).is_empty():
			continue
		if id == "navy" and Naval.limit(g, n.tag) <= 0.0:
			continue
		var c: Array = pool(g, n, id)
		for i in range(c.size() - 1, -1, -1):
			if n.gold - hire_cost(g, n, int(c[i].skill)) >= float(cfg(g).get("ai_min_gold", 120)):
				hire(g, n.tag, id, i)
				return
		return


# ---------------------------------------------------------------- save

static func load_save(g, n, d: Dictionary) -> void:
	var c := {}
	for id in d.get("council", {}):
		if seat_def(g, id).is_empty():
			continue
		var m: Dictionary = d.council[id]
		var o := default_opts(g, id)
		var mo: Dictionary = m.get("opt", {})
		for k in mo:
			if o.has(k):
				o[k] = mo[k] if typeof(o[k]) == TYPE_STRING else float(mo[k])
		c[id] = {"name": str(m.get("name", "")), "skill": clampi(int(m.get("skill", 1)), 1, max_skill(g)),
				"since": int(m.get("since", 0)), "lvl_since": int(m.get("lvl_since", 0)), "auto": bool(m.get("auto", false)), "opt": o}
	n.gov.council = c
	var p := {}
	for id in d.get("cpool", {}):
		var e: Dictionary = d.cpool[id]
		var cs := []
		for x in e.get("c", []):
			cs.append({"name": str(x.get("name", "")), "skill": int(x.get("skill", 1))})
		p[id] = {"m": int(e.get("m", 0)), "c": cs}
	n.gov.cpool = p
