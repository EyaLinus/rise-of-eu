extends RefCounted
## Historical landmarks (data/landmarks.json, generated by tools/content/landmarks.py): medium prestige
## buildings on single provinces, e.g. Notre-Dame in Paris or the Port of Seville. Unlike the great works
## (Monuments, one per realm in the capital) a landmark belongs to its province: whoever owns the province
## owns the landmark. Many stand in 1444 (start level 1-3), others can only be founded later (tech).
## The owner raises a landmark level by level up to 3 with gold; every level takes months and multiplies
## its effects: local ones (merged into p.loc by Economy.refresh_local) and realm-wide ones (bonus source
## "landmarks"). Landmarks with "bound" belong to one realm's history: only that realm may build or raise
## them, any other owner gets half of their realm-wide bonus.
## State on the game: g.landmarks id -> {"lvl", "months", "by"} (months > 0 while a level is being built),
## g.lm_defs id -> definition (+ "pid"), g.lm_at pid -> [ids]. Static helpers on the game `g`.

const MAX_LEVEL := 3
const KIND_TECH := {"church": "adm", "mosque": "adm", "palace": "adm", "school": "adm", "temple": "adm",
		"port": "dip", "market": "dip", "fortress": "mil"}
const KIND_NAMES := {"church": "Kirche", "mosque": "Moschee", "palace": "Palast", "school": "Gelehrtenstätte",
		"temple": "Heiligtum", "port": "Hafen", "market": "Handelsplatz", "fortress": "Festung"}


static func setup(g, data: Dictionary) -> void:
	g.lm_defs = {}
	g.lm_at = {}
	g.landmarks = {}
	var defs: Dictionary = data.get("landmarks", {})
	for id in defs:
		var d: Dictionary = defs[id].duplicate()
		var pid: int = g.key_to_pid.get(str(d.prov), -1)
		if pid < 0:
			push_warning("landmark %s: unknown province %s" % [id, d.prov])
			continue
		d["pid"] = pid
		g.lm_defs[id] = d
		if not g.lm_at.has(pid):
			g.lm_at[pid] = []
		g.lm_at[pid].append(id)
		g.landmarks[id] = {"lvl": int(d.get("start", 0)), "months": 0, "by": ""}
	g.lm_ver += 1
	refresh_bonus(g)


static func level(g, id: String) -> int:
	return int(g.landmarks[id].lvl) if g.landmarks.has(id) else 0


static func building(g, id: String) -> bool:
	return g.landmarks.has(id) and int(g.landmarks[id].months) > 0


static func owner(g, id: String) -> String:
	return g.provinces[g.lm_defs[id].pid].owner


## Ids of the landmarks in province `pid` (empty for most provinces).
static func at(g, pid: int) -> Array:
	return g.lm_at.get(pid, [])


## The landmark the map shows for a province: the highest built level (ties: the first in the data).
static func shown(g, pid: int) -> String:
	var best := ""
	var bl := 0
	for id in g.lm_at.get(pid, []):
		var l := level(g, id)
		if l > bl:
			best = id
			bl = l
	return best


## [category, level] of the technology the next level needs.
static func tech_req(g, id: String) -> Array:
	var d: Dictionary = g.lm_defs[id]
	var t: Array = d.get("tech", [KIND_TECH.get(d.kind, "adm"), 0])
	var nxt: int = level(g, id) + 1
	return [str(t[0]), int(t[1]) + (nxt - 1) * int(g.bal.landmark_tech_step)]


## Gold for the next level, by level, the landmark's own factor, the province's development and the
## realm's build cost modifier.
static func cost(g, tag: String, id: String) -> float:
	var d: Dictionary = g.lm_defs[id]
	var nxt: int = mini(level(g, id) + 1, MAX_LEVEL)
	var p = g.provinces[d.pid]
	var base: float = float(g.bal.landmark_cost[nxt - 1]) * float(d.get("cost", 1.0))
	var m: float = g.Economy.build_cost_mult(g, g.nations[tag]) if g.nations.has(tag) else 1.0
	return round(base * (1.0 + p.dev * float(g.bal.landmark_cost_per_dev)) * m)


static func months(g, id: String) -> int:
	var nxt: int = mini(level(g, id) + 1, MAX_LEVEL)
	return int(g.bal.landmark_months[nxt - 1])


## Why `tag` cannot raise landmark `id` now ("" = it can).
static func block_reason(g, tag: String, id: String) -> String:
	if not g.lm_defs.has(id):
		return "Unbekanntes Bauwerk."
	var d: Dictionary = g.lm_defs[id]
	var p = g.provinces[d.pid]
	if p.owner != tag:
		return "Gehört nicht dir."
	if d.has("bound") and d.bound != tag:
		return "Nur %s kann es errichten und ausbauen." % (g.nations[d.bound].name if g.nations.has(d.bound) else d.bound)
	var lvl := level(g, id)
	if lvl >= MAX_LEVEL:
		return "Höchste Stufe erreicht."
	if building(g, id):
		return "Wird schon ausgebaut."
	if p.controller != tag:
		return "Die Provinz ist besetzt."
	var n = g.nations[tag]
	var req := tech_req(g, id)
	if int(n.tech[req[0]]) < int(req[1]):
		return "Braucht %s-Technologie %d." % [{"adm": "Verwaltungs", "dip": "Diplomatie", "mil": "Militär"}[req[0]], int(req[1])]
	var c := cost(g, tag, id)
	if n.gold < c:
		return "Zu wenig Gold (%d)." % int(c)
	return ""


## Pays and starts the next level (level 1 = founding).
static func invest(g, tag: String, id: String) -> String:
	var r := block_reason(g, tag, id)
	if r != "":
		return r
	g.nations[tag].gold -= cost(g, tag, id)
	var s: Dictionary = g.landmarks[id]
	s.months = months(g, id)
	s.by = tag
	g.lm_ver += 1
	return ""


## Monthly (own step of the month): building progress for the few running works, and every month a
## twelfth of all landmarks gets an AI owner's look. Then the realm bonuses of all owners, in one pass.
static func monthly(g) -> void:
	var i := 0
	var slice: int = g.month % 12
	var owners := PackedStringArray()
	for id in g.landmarks:
		var s: Dictionary = g.landmarks[id]
		if int(s.months) > 0:
			_progress(g, id, s)
		elif i % 12 == slice:
			_ai_consider(g, id)
		owners.append(g.provinces[g.lm_defs[id].pid].owner)
		i += 1
	# the realm bonuses only change with a level or an owner
	if g.lm_ver != g.lm_seen_ver or owners != g.lm_seen_owners:
		refresh_bonus(g)
		g.lm_seen_ver = g.lm_ver
		g.lm_seen_owners = owners


static func _progress(g, id: String, s: Dictionary) -> void:
	var d: Dictionary = g.lm_defs[id]
	var p = g.provinces[d.pid]
	if p.owner != s.by:  # lost the province: the work stops, the gold is gone
		if s.by == g.player:
			g.log_msg("🏚️ Der Ausbau von %s ist verloren: %s gehört nicht mehr dir." % [d.name, p.name], [s.by])
		s.months = 0
		s.by = ""
		g.lm_ver += 1
		return
	if p.controller != p.owner:
		return  # paused while occupied
	s.months = int(s.months) - 1
	if int(s.months) > 0:
		return
	s.lvl = mini(int(s.lvl) + 1, MAX_LEVEL)
	s.by = ""
	p.dev = mini(int(g.bal.max_dev), p.dev + int(g.bal.landmark_dev))
	g.Economy.refresh_local(g, p)
	g.lm_ver += 1
	var n = g.nations[p.owner]
	var text := "%s %s: %s erreicht Stufe %d." % [d.emoji, n.name, d.name, int(s.lvl)] if int(s.lvl) > 1 else "%s %s errichtet %s." % [d.emoji, n.name, d.name]
	if int(s.lvl) >= MAX_LEVEL and (n.major or p.owner == g.player):
		g.world_event(text, [p.owner])
	else:
		g.log_msg(text, [p.owner])
	g.fire_event(p.owner, "lm_done")


## AI: raise a landmark when the treasury holds several times its price and the realm is at peace.
static func _ai_consider(g, id: String) -> void:
	var tag := owner(g, id)
	if tag == g.player or not g.nations.has(tag) or not g.nations[tag].alive or g.is_at_war(tag):
		return
	var n = g.nations[tag]
	var c := cost(g, tag, id)
	if n.gold < c * float(g.bal.ai_landmark_gold_mult) + float(g.bal.ai_landmark_reserve):
		return
	invest(g, tag, id)


## Local effects of the landmarks in province `p` (Economy.refresh_local).
static func local_effects(g, p) -> Dictionary:
	var out := {}
	for id in g.lm_at.get(p.id, []):
		var lvl := level(g, id)
		if lvl <= 0:
			continue
		var loc: Dictionary = g.lm_defs[id].get("local", {})
		for k in loc:
			out[k] = out.get(k, 0.0) + float(loc[k]) * lvl
	return out


## Realm-wide effects of one landmark for its current owner (half for a foreign owner of a bound one).
static func nation_effects(g, id: String, tag: String = "") -> Dictionary:
	var d: Dictionary = g.lm_defs[id]
	if tag == "":
		tag = owner(g, id)
	var lvl := maxi(1, level(g, id))
	var f: float = float(lvl)
	if d.has("bound") and d.bound != tag:
		f *= float(g.bal.landmark_foreign_mult)
	var out := {}
	for k in d.get("nation", {}):
		out[k] = float(d.nation[k]) * f
	return out


## Sets the "landmarks" bonus of every realm that owns built landmarks (and clears it where none are left).
static func refresh_bonus(g) -> void:
	var by := {}
	for id in g.landmarks:
		if level(g, id) <= 0:
			continue
		var tag := owner(g, id)
		if not g.nations.has(tag):
			continue
		if not by.has(tag):
			by[tag] = {}
		var b: Dictionary = by[tag]
		var e := nation_effects(g, id, tag)
		for k in e:
			b[k] = b.get(k, 0.0) + e[k]
	for tag in g.lm_owners:
		if not by.has(tag):
			g.nations[tag].clear_bonus("landmarks")
	for tag in by:
		g.nations[tag].set_bonus("landmarks", by[tag])
	g.lm_owners = by.keys()


## Landmarks of a realm (ids), built ones first, then by level.
static func of(g, tag: String) -> Array:
	var out := []
	for id in g.landmarks:
		if owner(g, id) == tag:
			out.append(id)
	out.sort_custom(func(a, b): return level(g, a) > level(g, b) if level(g, a) != level(g, b) else str(a) < str(b))
	return out


static func count_levels(g, tag: String) -> int:
	var c := 0
	for id in g.landmarks:
		if owner(g, id) == tag:
			c += level(g, id)
	return c


## Event/mission reward: one free level for the realm's best landmark that can still grow (no gold, no time).
static func free_level(g, tag: String) -> bool:
	var best := ""
	for id in of(g, tag):
		var d: Dictionary = g.lm_defs[id]
		if level(g, id) >= MAX_LEVEL or building(g, id) or (d.has("bound") and d.bound != tag):
			continue
		if best == "" or level(g, id) > level(g, best):
			best = id
	if best == "":
		return false
	g.landmarks[best].lvl = level(g, best) + 1
	g.Economy.refresh_local(g, g.provinces[g.lm_defs[best].pid])
	g.lm_ver += 1
	return true


static func to_save(g) -> Dictionary:
	var out := {}
	for id in g.landmarks:
		var s: Dictionary = g.landmarks[id]
		out[id] = [int(s.lvl), int(s.months), str(s.by)]
	return out


## Saves without landmarks keep the 1444 levels.
static func load_save(g, d: Dictionary) -> void:
	for id in d:
		if not g.landmarks.has(id):
			continue
		var e: Array = d[id]
		g.landmarks[id] = {"lvl": clampi(int(e[0]), 0, MAX_LEVEL), "months": int(e[1]), "by": str(e[2]) if e.size() > 2 else ""}
	g.lm_ver += 1
	refresh_bonus(g)

