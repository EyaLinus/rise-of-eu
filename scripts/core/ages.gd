extends RefCounted
## Age decisions ("Weichen des Zeitalters", data/ages.json, generated by tools/content/age_decisions.py).
## Every age asks three questions. A question is put as the manual event "age_q_<id>" once its year has come;
## the options carry the effect {"age_pick": [question, option]}. The chosen option counts for the rest of the
## game: its modifiers go into n.bonus["ages"], it can be deepened (level 2 and 3 add "up" each, paid in power)
## and it may get a synergy bonus from an earlier choice. Events can change a choice later (age_pick again):
## that is how a realm leaves the slave trade or forced labour.
## State: n.age_picks = {question id: [option id, level]}. Static helpers on the game `g`.


static func setup(g, data: Dictionary) -> void:
	g.age_cfg = data.get("ages", {})
	g.age_q = {}
	g.age_opt = {}
	for q in g.age_cfg.get("questions", []):
		g.age_q[q.id] = q
		for o in q.options:
			g.age_opt[o.id] = [q, o]


static func questions(g) -> Array:
	return g.age_cfg.get("questions", [])


static func max_level(g) -> int:
	return int(g.age_cfg.get("max_level", 3))


## The option a nation chose for `qid` ({} = undecided).
static func chosen(g, n, qid: String) -> Dictionary:
	if not n.age_picks.has(qid) or not g.age_opt.has(n.age_picks[qid][0]):
		return {}
	return g.age_opt[n.age_picks[qid][0]][1]


static func level(n, qid: String) -> int:
	return int(n.age_picks[qid][1]) if n.age_picks.has(qid) else 0


static func has_pick(g, n, oid: String) -> bool:
	if not g.age_opt.has(oid):
		return false
	var qid: String = g.age_opt[oid][0].id
	return n.age_picks.has(qid) and n.age_picks[qid][0] == oid


## True when the option's synergy partner was chosen.
static func synergy_on(g, n, o: Dictionary) -> bool:
	return o.has("synergy") and has_pick(g, n, o.synergy["with"])


## Modifiers of option `o` at `lvl`, with its synergy when `syn`.
static func option_effects(o: Dictionary, lvl: int, syn: bool) -> Dictionary:
	var b := {}
	for k in o.effects:
		b[k] = float(o.effects[k])
	for k in o.get("up", {}):
		b[k] = b.get(k, 0.0) + float(o.up[k]) * maxi(0, lvl - 1)
	if syn:
		for k in o.synergy.effects:
			b[k] = b.get(k, 0.0) + float(o.synergy.effects[k])
	return b


static func refresh(g, n) -> void:
	var b := {}
	for qid in n.age_picks:
		var o := chosen(g, n, qid)
		if o.is_empty():
			continue
		var e := option_effects(o, level(n, qid), synergy_on(g, n, o))
		for k in e:
			b[k] = b.get(k, 0.0) + e[k]
	n.bonus["ages"] = b


## Sets the choice for a question (also used to change it later through an event; the level is kept).
## The one-time "once" effects are paid only for the first choice of a question.
static func pick(g, tag: String, qid: String, oid: String) -> String:
	if not g.age_q.has(qid) or not g.age_opt.has(oid) or g.age_opt[oid][0].id != qid:
		return "Unbekannte Entscheidung."
	var n = g.nations[tag]
	var o: Dictionary = g.age_opt[oid][1]
	var first: bool = not n.age_picks.has(qid)
	if not first and n.age_picks[qid][0] == oid:
		return "Schon so entschieden."
	n.age_picks[qid] = [oid, 1 if first else level(n, qid)]
	refresh(g, n)
	if first and o.has("once"):
		g.apply_effects(tag, o.once)
	var q: Dictionary = g.age_q[qid]
	if tag == g.player:
		g.log_msg("⚖ %s: %s." % [q.title, o.name], [tag])
	elif not first and (n.major or n.formed != ""):
		g.world_event("⚖ %s ändert seinen Kurs: %s." % [n.name, o.name])
	return ""


static func up_cost(g, n, qid: String) -> float:
	var costs: Array = g.age_cfg.get("up_cost", [100, 160])
	return float(costs[clampi(level(n, qid) - 1, 0, costs.size() - 1)])


static func up_block(g, tag: String, qid: String) -> String:
	var n = g.nations[tag]
	var o := chosen(g, n, qid)
	if o.is_empty():
		return "Noch nicht entschieden."
	if level(n, qid) >= max_level(g):
		return "Schon voll ausgebaut."
	if n.get(o.power) < up_cost(g, n, qid):
		return "Zu wenig Punkte (%d)." % int(up_cost(g, n, qid))
	return ""


## Deepen a choice: one level more, paid in the option's kind of power.
static func upgrade(g, tag: String, qid: String) -> String:
	var r := up_block(g, tag, qid)
	if r != "":
		return r
	var n = g.nations[tag]
	var o := chosen(g, n, qid)
	n.set(o.power, n.get(o.power) - up_cost(g, n, qid))
	n.age_picks[qid][1] = level(n, qid) + 1
	refresh(g, n)
	return ""


## Questions whose year has come and that this nation has not answered yet.
static func open_questions(g, n) -> Array:
	var r := []
	for q in questions(g):
		if g.year() >= int(q.year) and not n.age_picks.has(q.id):
			r.append(q)
	return r


## Yearly: put the next due question (popup for the player, weighted choice for the AI) and let the AI deepen a
## choice now and then when it can still afford its next technology afterwards.
static func yearly(g, n) -> void:
	var due := open_questions(g, n)
	if not due.is_empty():  # one question a year, so an old save does not get a row of popups
		g.fire_event(n.tag, "age_q_" + due[0].id)
	if n.tag == g.player or g.rng.randf() > float(g.age_cfg.get("ai_up_chance", 0.2)):
		return
	for qid in n.age_picks:
		var o := chosen(g, n, qid)
		if not o.is_empty() and up_block(g, n.tag, qid) == "" and n.get(o.power) >= up_cost(g, n, qid) + g.tech_cost(n.tag, o.power):
			upgrade(g, n.tag, qid)
			return


static func to_save(n) -> Dictionary:
	return n.age_picks.duplicate(true)


static func load_save(g, n, d: Dictionary) -> void:
	n.age_picks = {}
	for qid in d:
		var v: Array = d[qid]
		if g.age_q.has(qid) and v.size() == 2 and g.age_opt.has(str(v[0])):
			n.age_picks[str(qid)] = [str(v[0]), clampi(int(v[1]), 1, max_level(g))]
	refresh(g, n)
